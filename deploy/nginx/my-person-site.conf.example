upstream my_person_site_frontend_prod {
  server 127.0.0.1:3100;
}

upstream my_person_site_backend_prod {
  server 127.0.0.1:3200;
}

server {
  listen 80;
  server_name your-domain.example.com;

  location /api/ {
    proxy_pass http://my_person_site_backend_prod;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /person-site {
    return 301 /person-site/;
  }

  location /person-site/ {
    proxy_pass http://my_person_site_frontend_prod;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}

# Duplicate the server block for your development domain and switch ports to:
# frontend: 3101
# backend: 3201
